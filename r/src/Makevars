# Builds the fortvine library with R's own Fortran compiler. fortvine/ holds copies of the
# library sources (tools/sync_r_src.sh) with the extension .F90, so the compiler preprocesses
# them and pulls in the .inc files next to them. OpenMP: the Fortran macro for compiling, the C
# macro for linking (the C compiler links the package), as Writing R Extensions describes;
# without OpenMP both are empty and the library runs on one thread. init.c calls the C
# interface of fortvine_capi (the typed API) and fv_pseudo_obs of fortvine. There is no Fortran
# file at the top of src/, so R neither adds the Fortran runtime ($(FLIBS)) nor applies
# PKG_FCFLAGS (it does so only for free-form sources at the top of src/): the Fortran flags are
# FV_FCFLAGS, passed by the rules below, and init.c (C) carries the C OpenMP macro.
FV_FCFLAGS = -DFORTVINE_NO_IO $(SHLIB_OPENMP_FFLAGS)
PKG_CFLAGS = $(SHLIB_OPENMP_CFLAGS)
PKG_LIBS = $(SHLIB_OPENMP_CFLAGS) $(FLIBS)

OBJECTS = fv_util.o fortvine_ad.o fortvine.o fortvine_api.o fortvine_capi.o init.o

all: $(SHLIB)

# module dependency order (all must stay the first target)
fv_util.o: fortvine/fv_util.F90
	$(FC) $(FV_FCFLAGS) $(ALL_FCFLAGS) -c fortvine/fv_util.F90 -o $@
fortvine_ad.o: fortvine/fortvine_ad.F90 fortvine/fortvine_adk.inc fv_util.o
	$(FC) $(FV_FCFLAGS) $(ALL_FCFLAGS) -c fortvine/fortvine_ad.F90 -o $@
fortvine.o: fortvine/fortvine.F90 fortvine_ad.o fv_util.o fortvine/families_core.inc \
  fortvine/families_ext.inc fortvine/families_gen.inc fortvine/newton1.inc
	$(FC) $(FV_FCFLAGS) $(ALL_FCFLAGS) -c fortvine/fortvine.F90 -o $@
fortvine_api.o: fortvine/fortvine_api.F90 fortvine.o
	$(FC) $(FV_FCFLAGS) $(ALL_FCFLAGS) -c fortvine/fortvine_api.F90 -o $@
fortvine_capi.o: fortvine/fortvine_capi.F90 fortvine_api.o
	$(FC) $(FV_FCFLAGS) $(ALL_FCFLAGS) -c fortvine/fortvine_capi.F90 -o $@
